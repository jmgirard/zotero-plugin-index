---
import Base from "../layouts/Base.astro";
import { displayName, loadData, pluginHref, rangeFields, rangeText } from "../data.ts";

const { plugins } = loadData();
---

<Base title="Zotero plugin index">
  <h1>Zotero plugin index</h1>
  <p>
    Plugins for Zotero 7 and later. A plugin can declare the Zotero versions it supports. Enter your Zotero version
    above to see where it falls in each declared range.
  </p>
  <table>
    <thead>
      <tr><th>Plugin</th><th>Declared range</th><th>Your version</th></tr>
    </thead>
    <tbody>
      {
        plugins.map((record) => (
          <tr data-plugin={record.id}>
            <td>
              <a href={pluginHref(record.id)}>{displayName(record)}</a>
              {record.upstream?.archived === true && <span data-archived>(archived)</span>}
            </td>
            <td>{record.failure ? `Not read: ${record.failure.name}` : rangeText(record)}</td>
            <td><span data-result-for={rangeFields(record)} /></td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>
