---
import { PAGE_SIZE, prePaintStyle } from "../../../src/site/home-filter.ts";
import { majorSupport, ZOTERO_MAJORS } from "../../../src/site/version.ts";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import {
  day,
  displayName,
  homeOrder,
  languageName,
  languageOptions,
  loadData,
  majorStart,
  monthYear,
  pluginHref,
  rowLanguagesAttribute,
  rowMajorsAttribute,
  safeHref,
  shortLanguages,
  shownDescription,
  startText,
  SUPPORT_MARKS as MARKS,
  supportText,
} from "../data.ts";

const { plugins, zoteroRelease } = loadData();

// A classic script runs as soon as the parser reaches it, before the table's rows parse, where
// the module script below runs only once the whole page has parsed. It hides at least the rows
// the module script will hide, so in a browser that reads :nth-child(… of S) none of them
// paints while the page loads. Only a browser that runs module scripts gets the style, since
// the module script removes it. A module script that throws or cannot parse reports an error
// to the window, so the style also goes on any such error, and every row shows again.
const prePaint = `if ("noModule" in HTMLScriptElement.prototype) {
  const style = document.createElement("style");
  style.setAttribute("data-pre-paint", "");
  style.textContent = (${prePaintStyle})(location.search, ${PAGE_SIZE});
  document.head.append(style);
  addEventListener("error", () => style.remove());
}`;
---

<Base title="Zotero plugin index">
  <div class="hero">
    <h1>Plugins for Zotero 7 and later</h1>
    <p class="intro">
      A daily build reads these facts from each plugin's GitHub repository and releases. It starts each plugin once in
      each tested Zotero release that its manifest's range covers, and starts it again for a new plugin file, after a
      failed start, and once a week.
    </p>
  </div>
  <div class="toolbar">
    <p class="search" hidden>
      <label for="search" class="visually-hidden">Search plugins</label>
      <Icon name="search" />
      <input type="search" id="search" data-search placeholder="Search plugins" autocomplete="off" />
    </p>
    <p class="language-filter" hidden>
      <label for="language">Menus and settings in</label>{" "}
      <select id="language" data-language-filter autocomplete="off">
        <option value="">All languages</option>
        {languageOptions(plugins).map(({ value, text }) => <option value={value}>{text}</option>)}
      </select>
    </p>
    <div class="version-filter" hidden>
      <span id="version-filter-label">Declares Zotero</span>
      <div role="group" aria-labelledby="version-filter-label" data-version-filter>
        <button type="button" aria-pressed="true">Any</button>
        {
          ZOTERO_MAJORS.map((major) => (
            <button type="button" value={major} aria-pressed="false">
              {major}
            </button>
          ))
        }
      </div>
    </div>
    <p class="filter-status" role="status" data-filter-status hidden></p>
  </div>
  <script is:inline set:html={prePaint} />
  <div class="table-card">
    <table class="plugins">
      <caption class="visually-hidden">Plugins in the index</caption>
      <colgroup>
        <col />
        <col span={ZOTERO_MAJORS.length} />
        <col class="lang" />
        <col class="date" />
        <col />
      </colgroup>
      <thead>
        <tr class="group">
          <td></td>
          <th scope="colgroup" colspan={ZOTERO_MAJORS.length}><span>Declares Zotero</span></th>
          <td class="lang"></td>
          <td class="date"></td>
          <td></td>
        </tr>
        <tr>
          <th scope="col">Plugin</th>
          {
            ZOTERO_MAJORS.map((major) => (
              <th scope="col" class="v">
                {major}
              </th>
            ))
          }
          <th scope="col" class="lang">Menus and settings</th>
          <th scope="col" class="date">Latest release</th>
          <th scope="col"><span class="visually-hidden">Links</span></th>
        </tr>
      </thead>
      <tbody>
        {
          homeOrder(plugins).map((record) => {
            const name = displayName(record);
            const description = shownDescription(record);
            const upstream = record.upstream;
            const sourceHref = safeHref(upstream?.repoUrl ?? record.repoUrl);
            const xpiHref = upstream?.xpiUrl === undefined ? undefined : safeHref(upstream.xpiUrl);
            const { shown, rest } = shortLanguages(record);
            const codes = [
              ...shown.map((subtag) => ({ text: subtag, title: languageName(subtag), more: false })),
              ...(rest.length > 0 ? [{ text: `+${rest.length}`, title: rest.map(languageName).join(", "), more: true }] : []),
            ];
            return (
              <tr data-plugin={record.id} data-languages={rowLanguagesAttribute(record)} data-zotero={rowMajorsAttribute(record, zoteroRelease)}>
                <th scope="row" class="name">
                  <a href={pluginHref(record.id)} data-name>{name}</a>
                  {upstream?.archived === true && <span class="badge" data-archived>Archived</span>}
                  {description && <div class="desc" data-description>{description}</div>}
                </th>
                {record.failure ? (
                  <td class="v not-read" colspan={ZOTERO_MAJORS.length} data-status="failure">
                    Not read
                  </td>
                ) : (
                  ZOTERO_MAJORS.map((major) => {
                    const support = majorSupport(record, major, zoteroRelease);
                    const start = majorStart(record, major);
                    return (
                      <td class="v" data-major={major}>
                        {support && (
                          <span class="mark" data-support={support} title={supportText(record, support, major)}>
                            <span aria-hidden="true">{MARKS[support]}</span>
                            <span class="visually-hidden">{supportText(record, support, major)}</span>
                          </span>
                        )}
                        {start && (
                          <span class="start" data-start={start.result} title={startText(start)}>
                            <span aria-hidden="true">{start.result === "started" ? "●" : "✕"}</span>
                            <span class="visually-hidden">Start test: {startText(start)}</span>
                          </span>
                        )}
                      </td>
                    );
                  })
                )}
                <td class="lang" data-languages-shown>
                  {
                    codes.map(({ text, title, more }, i) => (
                      <>
                        {i > 0 && " "}
                        <abbr class={more ? "more" : undefined} title={title}>
                          {text}
                        </abbr>
                      </>
                    ))
                  }
                </td>
                <td class="date">{upstream && <time datetime={day(upstream.latestReleaseDate)}>{monthYear(upstream.latestReleaseDate)}</time>}</td>
                <td class="links">
                  {sourceHref && (
                    <a href={sourceHref} data-link="source" title="Source code" aria-label={`Source code of ${name}`}>
                      <Icon name="source" />
                    </a>
                  )}
                  {upstream && xpiHref && (
                    <a
                      href={xpiHref}
                      data-link="download"
                      title={`Download version ${upstream.version} (.xpi)`}
                      aria-label={`Download ${name} ${upstream.version} (.xpi)`}
                    >
                      <Icon name="download" />
                    </a>
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <nav class="pager" aria-label="Pages" data-pager hidden>
    <button type="button" data-page-step="-1">Previous</button>
    <span role="status" data-page-status></span>
    <button type="button" data-page-step="1">Next</button>
  </nav>
  <ul class="legend" role="list" data-legend>
    <li><span class="mark" data-support="all" aria-hidden="true">{MARKS.all}</span> Declares every release of that Zotero version, up to its newest release</li>
    <li><span class="mark" data-support="some" aria-hidden="true">{MARKS.some}</span> Declares part of it</li>
    <li><span class="mark" data-support="none" aria-hidden="true">{MARKS.none}</span> Declares none of it</li>
    <li>No mark: the plugin declares no range</li>
    <li><span class="start" data-start="started" aria-hidden="true">●</span> Started in the start test</li>
    <li><span class="start" data-start="start-error" aria-hidden="true">✕</span> Failed to install, start, or answer in the start test</li>
    <li data-legend-note>
      A declared range comes from the plugin's manifest and the index's overrides, not from a test. A start test does not
      show that a plugin works.
    </li>
  </ul>
</Base>

<script>
  import {
    chosenPage,
    chosenValue,
    filterHref,
    filterOn,
    filterStatus,
    onPage,
    PAGE_SIZE,
    pageCount,
    rowShows,
  } from "../../../src/site/home-filter.ts";

  // The search box, the menu, the buttons, the count, and the pager are hidden in the HTML,
  // so a page without JavaScript shows every row and no control.
  const search = document.querySelector<HTMLInputElement>("input[data-search]");
  const select = document.querySelector<HTMLSelectElement>("select[data-language-filter]");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-version-filter] button")];
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const pager = document.querySelector<HTMLElement>("[data-pager]");
  const pageStatus = document.querySelector<HTMLElement>("[data-page-status]");
  const steps = [...document.querySelectorAll<HTMLButtonElement>("[data-pager] button")];
  const table = document.querySelector<HTMLElement>(".table-card");
  if (search && select && buttons.length > 0) {
    const languages = [...select.options].map((option) => option.value);
    // The "Any" button has no value attribute, so its value is "".
    const majors = buttons.map((button) => button.value);
    let major = "";
    let page = 1;
    const rows = [...document.querySelectorAll<HTMLElement>("tbody tr[data-plugin]")].map((row) => ({
      row,
      languages: row.dataset.languages ?? "",
      zotero: row.dataset.zotero ?? "",
      name: row.querySelector("[data-name]")?.textContent ?? "",
      description: row.querySelector("[data-description]")?.textContent ?? "",
    }));
    const language = () => ({ value: select.value, options: languages });
    const zotero = () => ({ value: major, options: majors });
    // The rows the search box, the menu, and the buttons pass, on every page.
    const passed = () => rows.filter((entry) => rowShows(entry, language(), zotero(), search.value));
    const show = () => {
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.value === major));
      const shown = passed();
      const pages = pageCount(shown.length);
      page = Math.min(page, pages);
      for (const entry of rows) entry.row.hidden = true;
      shown.forEach((entry, i) => (entry.row.hidden = !onPage(i, page)));
      if (status) {
        const filtering = search.value.trim() !== "" || filterOn(language()) || filterOn(zotero());
        status.textContent = filterStatus(shown.length, rows.length, filtering);
      }
      if (pager) pager.hidden = shown.length <= PAGE_SIZE;
      if (pageStatus) pageStatus.textContent = `Page ${page} of ${pages}`;
      // aria-disabled rather than disabled, so a button at an end keeps the keyboard focus.
      for (const step of steps) {
        const end = step.dataset.pageStep === "-1" ? 1 : pages;
        step.setAttribute("aria-disabled", String(page === end));
      }
    };
    const address = () =>
      filterHref(
        filterHref(filterHref(filterHref(location.href, "q", search.value.trim()), "language", select.value), "zotero", major),
        "page",
        page > 1 ? String(page) : "",
      );
    // Reads the parameters into the search box, the menu, the buttons, and the page, on load
    // and when Back or Forward changes the address in the same page. A parameter that names
    // no option, or no page after 1, leaves the address.
    // Typing writes the address once the visitor stops for half a second, so a burst of keys
    // makes one history call, not one per key.
    let pending: ReturnType<typeof setTimeout> | undefined;
    const write = () => {
      clearTimeout(pending);
      history.replaceState(null, "", address());
    };
    // The filter parameters are read first, so the page parameter is judged against the pages
    // that the filtered rows fill.
    const fromAddress = () => {
      clearTimeout(pending);
      const params = new URL(location.href).searchParams;
      search.value = params.get("q") ?? "";
      select.value = chosenValue(params.get("language"), languages);
      major = chosenValue(params.get("zotero"), majors);
      page = chosenPage(params.get("page"), pageCount(passed().length));
      show();
      const href = address();
      if (href !== location.href) history.replaceState(null, "", href);
    };
    // Each filter event goes back to page 1.
    const update = () => {
      page = 1;
      show();
      write();
    };
    fromAddress();
    addEventListener("popstate", fromAddress);
    search.addEventListener("input", () => {
      page = 1;
      show();
      clearTimeout(pending);
      pending = setTimeout(write, 500);
    });
    select.addEventListener("change", update);
    for (const button of buttons) {
      button.addEventListener("click", () => {
        major = button.value;
        update();
      });
    }
    // Previous and Next add a history entry, so Back returns to the page before. The new
    // address also carries any search text that typing had not written yet.
    for (const step of steps) {
      step.addEventListener("click", () => {
        if (step.getAttribute("aria-disabled") === "true") return;
        clearTimeout(pending);
        page += Number(step.dataset.pageStep);
        show();
        history.pushState(null, "", address());
        table?.scrollIntoView({ block: "start" });
      });
    }
    search.closest("[hidden]")?.removeAttribute("hidden");
    select.closest("[hidden]")?.removeAttribute("hidden");
    buttons[0]!.closest("[hidden]")?.removeAttribute("hidden");
    status?.removeAttribute("hidden");
  }
  // Each row's hidden now says what shows, so the style that the classic script added goes,
  // also when the page lacks a control.
  document.querySelector("style[data-pre-paint]")?.remove();
</script>
