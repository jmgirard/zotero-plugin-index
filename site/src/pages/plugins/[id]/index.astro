---
import Support from "../../../components/Support.astro";
import Base from "../../../layouts/Base.astro";
import {
  day,
  declaredRange,
  displayName,
  languagesText,
  loadData,
  overrideUsed,
  rangeText,
  reportHref,
  safeHref,
  shownDescription,
  startTestsText,
  upstreamValue,
  type PluginRecord,
} from "../../../data.ts";

export function getStaticPaths() {
  return loadData().plugins.map((record) => ({ params: { id: record.id }, props: { record } }));
}

const { record } = Astro.props as { record: PluginRecord };
const { upstream, failure, overrides } = record;
// Data written before the build counted reports has no reports field.
const reports = record.reports ?? [];
// Data written before the start tests, and a record no tested release gave a result for, have none.
const startTests = record.startTests ?? [];
const repoUrl = upstream?.repoUrl ?? record.repoUrl;
const repoHref = safeHref(repoUrl);
const description = shownDescription(record);
const { min, max } = declaredRange(record);
---

<Base title={`${displayName(record)}: Zotero plugin index`}>
  <h1>{displayName(record)}{upstream?.archived === true && <span data-archived>(archived)</span>}</h1>
  {description && <p class="description" data-description>{description}</p>}
  {
    failure ? (
      <p data-fact="failure">
        The last build could not read this plugin: <code>{failure.name}</code>: {failure.message}
      </p>
    ) : (
      <Support record={record} />
    )
  }
  {
    (min !== undefined || max !== undefined) && (
      <p class="range">
        Declared range: <span data-fact="declared-range">{rangeText(record)}</span>
      </p>
    )
  }
  {
    upstream && (
      <p class="languages">
        Menus and settings in: <span data-fact="languages">{languagesText(record)}</span>
      </p>
    )
  }
  {
    upstream && startTests.length > 0 && (
      <div class="start-tests" data-start-tests>
        <p>
          Starts in Zotero: <span data-fact="start-tests">{startTestsText(record)}</span>
        </p>
        <p class="status" data-fact="start-test-note">
          The daily build installs version {upstream.version} in a new Zotero profile on Linux and
          waits 3 seconds. A start test does not show that the plugin works.
        </p>
      </div>
    )
  }
  {
    upstream && (
      <section class="reports" data-reports>
        <p data-fact="report-version">User reports on version {upstream.version}, the version the index read</p>
        {reports.length > 0 ? (
          <ul class="report-counts">
            {reports.map(({ zoteroMajor, works, broken }) => (
              <li data-report-major={zoteroMajor}>
                Zotero {zoteroMajor}: {works} works, {broken} broken
              </li>
            ))}
          </ul>
        ) : (
          <p class="status" data-fact="no-reports">No reports on this version yet.</p>
        )}
        <p class="report-links">
          Tried this version on Zotero? Report that it{" "}
          <a data-report="works" href={reportHref(record, "works")}>Works</a> or is{" "}
          <a data-report="broken" href={reportHref(record, "broken")}>Broken</a>.
        </p>
      </section>
    )
  }
  <ul class="links">
    <li data-fact="repository">{repoHref ? <a href={repoHref}>{repoUrl}</a> : repoUrl}</li>
    {
      upstream && (
        <li data-fact="releases">
          {repoHref ? <a href={`${repoHref}/releases`}>Releases</a> : `${repoUrl}/releases`}
        </li>
      )
    }
  </ul>
  <details>
    <summary>Details</summary>
    <dl>
      <dt>Plugin id</dt>
      <dd data-fact="id"><code>{record.id}</code></dd>
      {
        upstream && (
          <>
            {typeof upstream.archived === "boolean" && (
              <>
                <dt>Archived on GitHub</dt>
                <dd data-fact="archived">{upstream.archived ? "Yes" : "No"}</dd>
              </>
            )}
            <dt>Repository created</dt>
            <dd data-fact="repo-created">{day(upstream.repoCreatedAt)}</dd>
            <dt>Release read by the index</dt>
            <dd data-fact="latest-release">
              {upstream.version}, published {day(upstream.latestReleaseDate)}
              {upstream.prerelease === true && " (prerelease)"}
            </dd>
            <dt>Releases with an .xpi</dt>
            <dd data-fact="release-count">{upstream.releaseCount}</dd>
            <dt>Open issues and pull requests</dt>
            <dd data-fact="open-issues">{upstream.openIssues}</dd>
            <dt>Host of update.json</dt>
            <dd data-fact="update-host">{upstream.updateHost}</dd>
          </>
        )
      }
    </dl>
    {
      overrides.length > 0 && (
        <section>
          <h2>Overrides</h2>
          <p>
            The index corrects these upstream facts.
            {upstream && ' An override marked "yes" under Used applies to the plugin version that the index read. The declared range above uses the strict_min_version and strict_max_version overrides marked "yes".'}
          </p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Field</th>
                  <th>Upstream value</th>
                  <th>Override value</th>
                  <th>For version</th>
                  <th>Used</th>
                  <th>Reason</th>
                </tr>
              </thead>
              <tbody>
                {overrides.map((override) => (
                  <tr data-override={override.field}>
                    <td><code>{override.field}</code></td>
                    <td>{upstreamValue(record, override.field) ?? "none"}</td>
                    <td>{override.value}</td>
                    <td>{override.version ?? "every version"}</td>
                    <td>{overrideUsed(record, override) ? "yes" : "no"}</td>
                    <td>{override.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }
  </details>
</Base>
