---
import { BASE } from "../base.ts";
import { day, loadData } from "../data.ts";

interface Props {
  title: string;
}
const { title } = Astro.props;
const { generatedAt } = loadData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        --text: #1d1d1f;
        --muted: #5f6368;
        --line: #e3e3e6;
        --card: #ffffff;
        --page: #f6f6f8;
        --link: #0b57d0;
        --all-bg: #e1f3e6;
        --all-text: #136c2e;
        --some-bg: #fdf0d5;
        --some-text: #8a5300;
        --none-bg: #eeeef0;
        --none-text: #6b6b70;
        --pressed-bg: #0b57d0;
        --pressed-text: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --text: #ececf0;
          --muted: #a4a4ab;
          --line: #34343a;
          --card: #1f1f24;
          --page: #151518;
          --link: #8ab4f8;
          --all-bg: #183823;
          --all-text: #8fdca5;
          --some-bg: #3d2f12;
          --some-text: #f2c46d;
          --none-bg: #2a2a30;
          --none-text: #9a9aa2;
          --pressed-bg: #8ab4f8;
          --pressed-text: #151518;
        }
      }
      body {
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        max-width: 50rem;
        margin: 0 auto;
        padding: 1rem;
        color: var(--text);
        background: var(--page);
        overflow-wrap: anywhere;
      }
      a {
        color: var(--link);
      }
      header {
        border-bottom: 1px solid var(--line);
        margin-bottom: 1rem;
      }
      header a {
        color: var(--text);
        font-weight: 600;
        text-decoration: none;
      }
      .intro,
      .range,
      .languages {
        color: var(--muted);
      }
      .version-filter {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 1rem 0;
      }
      .version-filter[hidden] {
        display: none;
      }
      /* Empty while no filter is on. It keeps its box so screen readers hear each new text. */
      .filter-status {
        margin: 0 0 1rem;
      }
      .filter-status:empty {
        margin: 0;
      }
      [data-version-filter] {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
      }
      [data-version-filter] button {
        font: inherit;
        font-size: 0.875rem;
        min-width: 3rem;
        padding: 0.25rem 0.75rem;
        border: 1px solid var(--muted);
        border-radius: 999px;
        background: var(--card);
        color: var(--text);
        cursor: pointer;
      }
      [data-version-filter] button[aria-pressed="true"] {
        background: var(--pressed-bg);
        border-color: var(--pressed-bg);
        color: var(--pressed-text);
        font-weight: 600;
      }
      [data-version-filter] button:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      /* Forced colors replace the backgrounds, so a thicker border marks the pressed button. */
      @media (forced-colors: active) {
        [data-version-filter] button[aria-pressed="true"] {
          border: 3px solid ButtonText;
        }
      }
      .plugins {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 0.75rem;
      }
      .plugin {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
      }
      .plugin p {
        margin: 0 0 0.5rem;
      }
      .plugin-name a {
        font-size: 1.125rem;
        font-weight: 600;
      }
      .description {
        color: var(--text);
      }
      [data-archived] {
        margin-left: 0.5rem;
        font-size: 0.8125rem;
        color: var(--muted);
      }
      .pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        margin: 0.5rem 0;
      }
      .pill {
        display: inline-block;
        min-width: 3rem;
        padding: 0.125rem 0.625rem;
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 600;
        text-align: center;
        font-variant-numeric: tabular-nums;
      }
      .pill[data-support="all"] {
        background: var(--all-bg);
        color: var(--all-text);
      }
      .pill[data-support="some"] {
        background: var(--some-bg);
        color: var(--some-text);
      }
      .pill[data-support="none"] {
        background: var(--none-bg);
        color: var(--none-text);
      }
      .status {
        color: var(--muted);
        font-size: 0.875rem;
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      .reports p {
        margin: 0.5rem 0;
      }
      .report-counts {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0;
        font-variant-numeric: tabular-nums;
      }
      .links {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }
      details {
        border-top: 1px solid var(--line);
        margin-top: 1.5rem;
        padding-top: 0.75rem;
      }
      summary {
        cursor: pointer;
        color: var(--muted);
      }
      dt {
        font-weight: 600;
        margin-top: 0.5rem;
      }
      dd {
        margin-left: 0;
      }
      .table-wrap {
        overflow-x: auto;
      }
      table {
        border-collapse: collapse;
        width: 100%;
      }
      th,
      td {
        text-align: left;
        padding: 0.25rem 0.5rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      footer {
        border-top: 1px solid var(--line);
        margin-top: 2rem;
        font-size: 0.875rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header>
      <p><a href={BASE}>Zotero plugin index</a></p>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p data-fact="not-vetted">This index does not vet the plugins it lists.</p>
      <p>The build read each plugin's repository and releases on {day(generatedAt)}.</p>
      <p>Data file: <a href={`${BASE}v1/plugins.json`}>v1/plugins.json</a></p>
    </footer>
  </body>
</html>
