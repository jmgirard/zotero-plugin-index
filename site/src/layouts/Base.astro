---
import { BASE } from "../base.ts";
import { day, loadData } from "../data.ts";

interface Props {
  title: string;
}
const { title } = Astro.props;
const { generatedAt } = loadData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        max-width: 50rem;
        margin: 0 auto;
        padding: 1rem;
      }
      header {
        border-bottom: 1px solid #ccc;
        padding-bottom: 0.5rem;
      }
      table {
        border-collapse: collapse;
        width: 100%;
      }
      th,
      td {
        text-align: left;
        padding: 0.25rem 0.5rem;
        border-bottom: 1px solid #eee;
        vertical-align: top;
      }
      dt {
        font-weight: bold;
      }
      .hint {
        font-size: 0.875rem;
        color: #555;
        margin: 0.25rem 0 0;
      }
      footer {
        border-top: 1px solid #ccc;
        margin-top: 2rem;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <header>
      <p><a href={BASE}>Zotero plugin index</a></p>
      <label for="zotero-version">Your Zotero version</label>
      <input id="zotero-version" type="text" placeholder="for example 8.0.1" autocomplete="off" spellcheck="false" />
      <p class="hint">In Zotero, open Help → About Zotero. On macOS, open Zotero → About Zotero.</p>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p data-fact="not-vetted">This index does not vet the plugins it lists.</p>
      <p>The build read each plugin's repository and releases on {day(generatedAt)}.</p>
      <p>Data file: <a href={`${BASE}v1/plugins.json`}>v1/plugins.json</a></p>
    </footer>
  </body>
</html>
