---
import { BASE } from "../base.ts";
import { ADD_PLUGIN_HREF, day, loadData } from "../data.ts";

interface Props {
  title: string;
}
const { title } = Astro.props;
const { generatedAt } = loadData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #f7f7f5;
        --surface: #ffffff;
        --hover: #f2f2ee;
        --text: #1c1c1a;
        --muted: #6b6b66;
        --faint: #8a8a84;
        --line: #e4e4df;
        --line-strong: #d3d3cc;
        --accent: #b5232f;
        --link: #1d5fb8;
        --ok: #1f7a3d;
        --ok-bg: #e3f3e7;
        --part: #8a5a00;
        --part-bg: #fbefd5;
        --bad: #b3261e;
        --bad-bg: #fbe4e1;
        --none: #8f8f88;
        /* --space-N is N eighths of a rem. */
        --space-1: 0.125rem;
        --space-2: 0.25rem;
        --space-3: 0.375rem;
        --space-4: 0.5rem;
        --space-5: 0.625rem;
        --space-6: 0.75rem;
        --space-8: 1rem;
        --space-9: 1.125rem;
        --space-10: 1.25rem;
        --space-12: 1.5rem;
        --space-14: 1.75rem;
        --space-16: 2rem;
        --space-24: 3rem;
        --text-3xs: 0.625rem;
        --text-2xs: 0.6875rem;
        --text-xs: 0.75rem;
        --text-s: 0.8125rem;
        --text-m: 0.875rem;
        --text-base: 0.9375rem;
        --text-xl: 1.375rem;
        --radius-xs: 0.125rem;
        --radius-s: 0.25rem;
        --radius-m: 0.375rem;
        --radius: 0.5rem;
        --page-width: 65rem;
        --card-border: var(--line);
        --card-padding: var(--space-6) var(--space-8);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #161615;
          --surface: #1e1e1c;
          --hover: #262624;
          --text: #ecece8;
          --muted: #a3a39c;
          --faint: #6e6e68;
          --line: #2e2e2b;
          --line-strong: #3d3d39;
          --accent: #f07178;
          --link: #7fb0ff;
          --ok: #6fd08c;
          --ok-bg: #173322;
          --part: #f0c060;
          --part-bg: #3a2e12;
          --bad: #ff8a80;
          --bad-bg: #3d1a17;
          --none: #74746d;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: var(--text-base);
        line-height: 1.5;
        font-variant-numeric: tabular-nums;
        color: var(--text);
        background: var(--bg);
        overflow-wrap: anywhere;
      }
      a {
        color: var(--link);
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      .icon {
        width: 1rem;
        height: 1rem;
        flex: none;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* The top bar, the main content, and the footer share one width. */
      .topbar-inner,
      main,
      .foot-inner {
        max-width: var(--page-width);
        margin: 0 auto;
        padding: 0 var(--space-8);
      }
      .topbar {
        background: var(--surface);
        border-bottom: 1px solid var(--line);
      }
      .topbar-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-12);
        min-height: 3.25rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        font-weight: 650;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand::before {
        content: "";
        width: 0.625rem;
        height: 0.625rem;
        border-radius: var(--radius-xs);
        background: var(--accent);
      }
      .topbar nav {
        display: flex;
        gap: var(--space-10);
        margin-left: auto;
        font-size: var(--text-m);
      }
      .topbar nav a {
        color: var(--muted);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand:hover,
      .topbar nav a:hover {
        color: var(--text);
        text-decoration: underline;
      }
      .foot {
        margin: var(--space-24) 0 var(--space-16);
        font-size: var(--text-s);
        color: var(--muted);
      }
      .foot-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3) var(--space-12);
      }
      .foot-rule {
        border-top: 1px solid var(--line);
        padding-top: var(--space-8);
      }
      .foot p {
        margin: 0;
      }

      /* The home page: heading, toolbar, table, and legend. */
      .hero {
        padding: var(--space-14) 0 var(--space-4);
      }
      .hero h1 {
        margin: 0 0 var(--space-2);
        font-size: var(--text-xl);
        line-height: 1.25;
        letter-spacing: -0.015em;
      }
      .intro {
        margin: 0;
        color: var(--muted);
      }
      .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-5) var(--space-8);
        padding: var(--space-9) 0 var(--space-6);
      }
      .toolbar p {
        margin: 0;
      }
      .search {
        position: relative;
        flex: 1 1 13.75rem;
        max-width: 20rem;
      }
      .search .icon {
        position: absolute;
        left: 0.625rem;
        top: 0.5rem;
        color: var(--faint);
      }
      /* The edges of the controls take --faint, which the color test holds at 3:1 on --surface. */
      .search input,
      [data-language-filter] {
        height: 2rem;
        border: 1px solid var(--faint);
        border-radius: var(--radius-m);
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: var(--text-m);
      }
      .search input {
        width: 100%;
        padding: 0 var(--space-5) 0 var(--space-16);
      }
      [data-language-filter] {
        max-width: 100%;
        padding: 0 var(--space-4);
      }
      .language-filter,
      .version-filter {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        font-size: var(--text-s);
        color: var(--muted);
      }
      /* The script removes hidden from each control, so a page without JavaScript shows none. */
      .search[hidden],
      .language-filter[hidden],
      .version-filter[hidden],
      .filter-status[hidden] {
        display: none;
      }
      [data-version-filter] {
        display: inline-flex;
        border: 1px solid var(--faint);
        border-radius: var(--radius-m);
        overflow: hidden;
        background: var(--surface);
      }
      [data-version-filter] button {
        height: 1.875rem;
        padding: 0 var(--space-5);
        border: 0;
        border-left: 1px solid var(--faint);
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        font-size: var(--text-s);
        cursor: pointer;
      }
      [data-version-filter] button:first-child {
        border-left: 0;
      }
      [data-version-filter] button[aria-pressed="true"] {
        background: var(--text);
        color: var(--surface);
        font-weight: 600;
      }
      .search input:focus-visible,
      [data-language-filter]:focus-visible,
      [data-version-filter] button:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      [data-version-filter]:has(button:focus-visible) {
        overflow: visible;
      }
      /* Forced colors replace the backgrounds, so a thicker border marks the pressed button. */
      @media (forced-colors: active) {
        [data-version-filter] button[aria-pressed="true"] {
          border: 3px solid ButtonText;
        }
      }
      .filter-status {
        margin-left: auto;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .table-card {
        overflow-x: auto;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
      }
      .plugins th,
      .plugins td {
        padding: var(--space-5) var(--space-6);
        border-bottom: 0;
        vertical-align: middle;
      }
      .plugins thead th {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--muted);
        border-bottom: 1px solid var(--line);
        white-space: nowrap;
      }
      .plugins .group th {
        padding-bottom: 0;
        border-bottom: 0;
        font-weight: 500;
        text-align: center;
      }
      .plugins .group th span {
        display: block;
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--line);
      }
      /* A row gets a top border only after a shown row, so the first shown row has none. */
      .plugins tbody tr:not([hidden]) ~ tr {
        border-top: 1px solid var(--line);
      }
      .plugins tbody tr:hover {
        background: var(--hover);
      }
      .plugins .name {
        width: 100%;
        font-weight: 400;
      }
      .plugins .name a {
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
      }
      .plugins .name a:hover {
        color: var(--link);
        text-decoration: underline;
      }
      .desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-width: 60ch;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .badge {
        display: inline-block;
        margin-left: var(--space-3);
        padding: 0 var(--space-3);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-s);
        font-size: var(--text-2xs);
        font-weight: 600;
        color: var(--muted);
        vertical-align: 1px;
      }
      .plugins .v {
        width: 2.5rem;
        padding-left: var(--space-1);
        padding-right: var(--space-1);
        text-align: center;
      }
      .plugins .not-read {
        width: auto;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .mark {
        display: inline-grid;
        place-items: center;
        width: 1.625rem;
        height: 1.375rem;
        border-radius: var(--radius-s);
        font-size: var(--text-xs);
        font-weight: 700;
        line-height: 1;
      }
      .mark[data-support="all"] {
        background: var(--ok-bg);
        color: var(--ok);
      }
      .mark[data-support="some"] {
        background: var(--part-bg);
        color: var(--part);
      }
      .mark[data-support="none"] {
        color: var(--none);
      }
      .start {
        display: block;
        height: 0.75rem;
        margin-top: var(--space-1);
        font-size: var(--text-3xs);
        line-height: 0.75rem;
        color: var(--bad);
        font-weight: 700;
      }
      .start[data-start="started"] {
        color: var(--ok);
        font-weight: 400;
      }
      .plugins .lang,
      .plugins .date {
        white-space: nowrap;
        font-size: var(--text-s);
        color: var(--muted);
      }
      .plugins .lang abbr {
        display: inline-block;
        padding: 0 var(--space-2);
        border-radius: var(--radius-xs);
        background: var(--hover);
        color: var(--muted);
        font-size: var(--text-2xs);
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        text-decoration: none;
      }
      .plugins .lang abbr.more {
        background: none;
        text-transform: none;
      }
      .plugins .links {
        padding-left: var(--space-2);
        white-space: nowrap;
        text-align: right;
      }
      .plugins .links a {
        display: inline-grid;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: var(--radius-m);
        color: var(--muted);
      }
      .plugins .links a:hover {
        background: var(--line);
        color: var(--text);
      }
      .plugins .links a:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: -2px;
      }
      .legend {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3) var(--space-9);
        margin: var(--space-6) var(--space-1) 0;
        padding: 0;
        list-style: none;
        font-size: var(--text-xs);
        color: var(--muted);
      }
      .legend li {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
      }
      .legend .start {
        display: inline;
        margin: 0;
      }
      @media (max-width: 760px) {
        .plugins .lang,
        .plugins .date {
          display: none;
        }
      }
      @media (max-width: 560px) {
        .plugins .desc,
        .plugins .links a[data-link="source"] {
          display: none;
        }
        .plugins th,
        .plugins td {
          padding: var(--space-4) var(--space-3);
        }
        .plugins .v {
          width: 1.875rem;
          padding-left: 0;
          padding-right: 0;
        }
        .mark {
          width: 1.375rem;
        }
        .filter-status {
          width: 100%;
          margin-left: 0;
        }
      }

      /* The plugin pages: cards, pills, report buttons, and the Details section. */
      .card,
      details {
        background: var(--surface);
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
        padding: var(--card-padding);
      }
      main > .card,
      main > details {
        margin: 0 0 var(--space-6);
      }
      .card > :first-child {
        margin-top: 0;
      }
      .card > :last-child {
        margin-bottom: 0;
      }
      .back {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        margin: var(--space-10) 0 0;
        font-size: var(--text-s);
        color: var(--muted);
        text-decoration: none;
      }
      .back:hover {
        color: var(--text);
        text-decoration: underline;
      }
      .page-head {
        padding: var(--space-6) 0 var(--space-10);
      }
      .page-head h1 {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-5);
        margin: 0;
        font-size: var(--text-xl);
        line-height: 1.25;
        letter-spacing: -0.015em;
      }
      .page-head h1 .badge {
        margin-left: 0;
        font-size: var(--text-xs);
        letter-spacing: 0;
      }
      .page-head .description {
        max-width: 68ch;
        margin: var(--space-3) 0 0;
        color: var(--muted);
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        margin: var(--space-8) 0 0;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        min-height: 2rem;
        padding: var(--space-1) var(--space-6);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-m);
        background: var(--surface);
        color: var(--text);
        font-size: var(--text-m);
        font-weight: 500;
        text-decoration: none;
      }
      .btn:hover {
        background: var(--hover);
      }
      .btn:focus-visible,
      .back:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      .link-text {
        font-size: var(--text-m);
        color: var(--muted);
      }
      .range,
      .languages {
        color: var(--muted);
      }
      .card h2,
      details h2 {
        margin: 0 0 var(--space-4);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .card p {
        margin: var(--space-4) 0;
      }
      .report-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        margin: var(--space-4) 0 0;
      }
      .button {
        display: inline-block;
        min-width: 5rem;
        padding: var(--space-3) var(--space-8);
        /* The fills are close to the card color, so the text color draws each button's edge. */
        border: 1px solid currentColor;
        border-radius: var(--radius-m);
        font-weight: 600;
        text-align: center;
        text-decoration: none;
      }
      .button:hover {
        text-decoration: underline;
      }
      .button:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }
      .button[data-report="works"] {
        background: var(--ok-bg);
        color: var(--ok);
      }
      .button[data-report="broken"] {
        background: var(--bad-bg);
        color: var(--bad);
      }
      /* Forced colors replace the text and border colors, so this rule draws each button's edge in ButtonText. */
      @media (forced-colors: active) {
        .button {
          border-color: ButtonText;
        }
      }
      .pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        margin: var(--space-4) 0;
      }
      .pill {
        display: inline-block;
        min-width: 3rem;
        padding: var(--space-1) var(--space-5);
        border-radius: var(--radius-s);
        font-size: var(--text-s);
        font-weight: 600;
        text-align: center;
      }
      .pill[data-support="all"] {
        background: var(--ok-bg);
        color: var(--ok);
      }
      .pill[data-support="some"] {
        background: var(--part-bg);
        color: var(--part);
      }
      .pill[data-support="none"] {
        background: var(--hover);
        color: var(--muted);
      }
      .status {
        color: var(--muted);
        font-size: var(--text-s);
      }
      .reports p {
        margin: var(--space-4) 0;
      }
      .report-counts {
        list-style: none;
        padding: 0;
        margin: var(--space-4) 0;
      }
      ul.links {
        list-style: none;
        padding: 0;
        margin: var(--space-4) 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4) var(--space-8);
      }
      details > :last-child {
        margin-bottom: 0;
      }
      summary {
        cursor: pointer;
        color: var(--muted);
      }
      dt {
        font-weight: 600;
        margin-top: var(--space-4);
      }
      dd {
        margin-left: 0;
      }
      .table-wrap {
        overflow-x: auto;
      }
      table {
        border-collapse: collapse;
        width: 100%;
      }
      th,
      td {
        text-align: left;
        padding: var(--space-2) var(--space-4);
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={BASE}>Zotero plugin index</a>
        <nav aria-label="Site">
          <a href={ADD_PLUGIN_HREF} data-add-plugin>Add a plugin</a>
          <a href={`${BASE}v1/plugins.json`}>Data</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="foot-inner foot-rule">
        <p data-fact="not-vetted">This index does not vet the plugins it lists.</p>
        <p>The build read each plugin's repository and releases on {day(generatedAt)}.</p>
        <p>Data file: <a href={`${BASE}v1/plugins.json`}>v1/plugins.json</a></p>
      </div>
    </footer>
  </body>
</html>
