---
// The declared support for each Zotero major: one pill per major, or a status line when
// the record was not read or declares no range.
import { majorSupport, ZOTERO_MAJORS, type MajorSupport } from "../../../src/site/version.ts";
import { rangeText, type PluginRecord } from "../data.ts";

interface Props {
  record: PluginRecord;
}
const { record } = Astro.props;

const MARKS: Record<MajorSupport, string> = { all: "✓", some: "◐", none: "–" };

function label(support: MajorSupport, major: string): string {
  if (support === "all") return `Declares all of Zotero ${major}`;
  if (support === "some") return `Declares part of Zotero ${major}. Declared range: ${rangeText(record)}`;
  return `Does not declare Zotero ${major}`;
}

const pills = ZOTERO_MAJORS.flatMap((major) => {
  const support = majorSupport(record, major);
  return support ? [{ major, support, text: label(support, major) }] : [];
});
---

{
  record.failure ? (
    <p class="status" data-status="failure">Not read: {record.failure.name}</p>
  ) : pills.length === 0 ? (
    <p class="status" data-status="no-range">No declared range</p>
  ) : (
    <div class="pills">
      {pills.map(({ major, support, text }) => (
        <span class="pill" data-major={major} data-support={support} title={text}>
          <span aria-hidden="true">
            {major} {MARKS[support]}
          </span>
          <span class="visually-hidden">{text}</span>
        </span>
      ))}
    </div>
  )
}
