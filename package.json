{
  "name": "zotero-plugin-index",
  "version": "0.0.0",
  "private": true,
  "description": "A community index of Zotero 7+ plugins",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "add-plugin": "node src/add-plugin/cli.ts",
    "build": "node src/build/cli.ts",
    "check": "node src/check/cli.ts",
    "close-issue": "node src/discover/close-issue-cli.ts",
    "discover": "node src/discover/cli.ts",
    "discover-issue": "node src/discover/issue-cli.ts",
    "propose": "node src/discover/propose-cli.ts",
    "report-issue": "node src/reports/issue-cli.ts",
    "site": "node src/site/cli.ts",
    "test": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "astro": "7.4.2",
    "fflate": "0.8.3"
  }
}
