{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jmgirard.github.io/zotero-plugin-index/schemas/index.v1.schema.json",
  "title": "zotero-plugin-index entry fields",
  "description": "Fields of plugins/<id>/index.json: the data the index keeps beside the registry meta.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema.",
      "const": 1
    },
    "overrides": {
      "description": "Corrections to upstream facts that the plugin author cannot or will not fix upstream.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "reason"],
        "if": { "required": ["field"], "properties": { "field": { "const": "languages" } } },
        "then": {
          "properties": {
            "value": {
              "description": "For languages: one or more language tags joined by \", \", such as \"zh-CN, en-US\".",
              "type": "string",
              "pattern": "^(?![Uu][Nn][Dd](?![A-Za-z0-9]))[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))?(, (?![Uu][Nn][Dd](?![A-Za-z0-9]))[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))?)*$"
            }
          }
        },
        "properties": {
          "field": {
            "description": "The upstream fact this override corrects.",
            "enum": ["name", "description", "homepage", "strict_min_version", "strict_max_version", "languages"]
          },
          "version": {
            "description": "The plugin version the override applies to. Absent means every version.",
            "type": "string",
            "minLength": 1
          },
          "value": {
            "description": "The corrected value.",
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "description": "Why the upstream value is wrong.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
